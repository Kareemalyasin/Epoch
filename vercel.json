{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run-pipeline",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/send-digest",
      "schedule": "0 6 * * *"
    }
  ]
}
